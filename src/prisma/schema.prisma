generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
 url  = env("DATABASE_URL")
}


model Donneur {
  id            Int      @id @default(autoincrement())
  nom           String   @db.VarChar(100)
  prenom        String   @db.VarChar(100)
  groupeSanguin String   @map("groupe_sanguin") @db.VarChar(3)
  telephone     String?  @db.VarChar(20)

  dons          Don[]

  @@map("donneurs")
}

model Centre {
  id        Int    @id @default(autoincrement())
  nom       String
  ville     String

  dons      Don[]
}

model Don {
  id        Int      @id @default(autoincrement())
  dateDon   DateTime @default(now())
  volume    Int

  donneurId Int
  centreId  Int

  donneur   Donneur  @relation(fields: [donneurId], references: [id])
  centre    Centre   @relation(fields: [centreId], references: [id])
}
enum Role {
  ADMIN
  AGENT_CENTRE
  RESPONSABLE_STOCK
}

model User {
  id        Int      @id @default(autoincrement())
  nom       String
  email     String   @unique
  password  String
  role      Role     @default(AGENT_CENTRE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}